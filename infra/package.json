{
  "name": "@fleet/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "echo 'No e2e tests configured yet'",
    "audit": "pnpm audit --prod",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "cdk": "cdk",
    "seed": "tsx seed/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.750.0",
    "@aws-sdk/client-resource-groups-tagging-api": "3.750.0",
    "@aws-sdk/client-sts": "3.750.0",
    "@aws-sdk/lib-dynamodb": "3.750.0",
    "@fleet/shared": "workspace:*",
    "aws-cdk-lib": "2.266.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "2.1138.0"
  }
}
