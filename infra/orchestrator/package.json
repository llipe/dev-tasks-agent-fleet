{
  "name": "@fleet/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "audit": "pnpm audit --prod",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --outfile=dist/handler.mjs --format=esm --external:@aws-sdk/*"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.750.0",
    "@aws-sdk/client-lambda": "3.750.0",
    "@aws-sdk/lib-dynamodb": "3.750.0",
    "@fleet/shared": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
