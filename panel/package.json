{
  "name": "panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "audit": "pnpm audit --prod --audit-level=high",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run audit"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.114.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.10.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.25",
    "jsdom": "25.0.1",
    "pg": "8.23.0",
    "playwright": "1.56.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
