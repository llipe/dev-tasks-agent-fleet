{
  "name": "panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "audit": "node scripts/audit.mjs",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run audit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1126.0",
    "@aws-sdk/client-ses": "3.1126.0",
    "@aws-sdk/client-sts": "3.1126.0",
    "@aws-sdk/credential-providers": "3.1126.0",
    "@aws-sdk/types": "3.974.5",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.18.0",
    "eslint-config-next": "16.4.1",
    "jsdom": "25.0.1",
    "pg": "8.23.0",
    "playwright": "1.64.1",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
