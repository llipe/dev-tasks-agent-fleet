# Keep the build context lean and secret-free.
#
# NOTE: the Docker build context is the MONOREPO ROOT (see panel/Dockerfile),
# so this file is referenced via `docker build -f panel/Dockerfile .` from the
# repo root. Paths here are relative to the repo root.

# Dependencies (reinstalled inside the image from the lockfile)
**/node_modules

# Build output / caches
**/.next
**/dist
**/coverage
**/.turbo
**/*.tsbuildinfo

# Secrets and local env — MUST never enter the image (SD2/D12/D15)
**/.env
**/.env.*
!**/.env.example

# VCS / editor / OS cruft
.git
.gitignore
**/.DS_Store
**/*.log

# Tests and CI artifacts not needed at runtime
**/tests/e2e/.artifacts
**/playwright-report
**/test-results

# Python agent tree — not part of the panel image
agents/**/.venv
agents/**/__pycache__
agents/**/.mypy_cache
agents/**/.pytest_cache
agents/**/.ruff_cache
