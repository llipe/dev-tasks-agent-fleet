# AgentCore Runtime requires linux/arm64.
#
# WHY THIS FILE LIVES AT THE REPOSITORY ROOT
#
# The agent imports the generated shared contract from packages/shared/generated,
# so the Docker build context must be the repository root. The AgentCore CLI
# supports that via `buildContextPath` in agents/dep-updater/agentcore/agentcore.json.
#
# The Dockerfile must ALSO sit at the build-context root. The CLI appends a
# "force-keep" of the Dockerfile and every ancestor directory to the end of the
# asset exclude list, and Docker ignore semantics are last-match-wins. A nested
# path like `agents/dep-updater/Dockerfile` therefore emits `!agents` and
# `!agents/dep-updater`, which re-include everything beneath them — including
# `.venv` and `agentcore/cdk/cdk.out` — and CDK asset staging then recurses into
# its own output directory until it dies on ENAMETOOLONG. Keeping the Dockerfile
# at the context root emits only `!Dockerfile.dep-updater`, so the baseline and
# .dockerignore exclusions survive.
#
# Build:
#   docker build --platform linux/arm64 -f Dockerfile.dep-updater -t dep-updater:local .
#
# Deploy (the CLI performs the build itself, in CodeBuild):
#   cd agents/dep-updater && agentcore deploy
#
# Base image comes from the ECR Public mirror of Docker Hub's official images,
# NOT from docker.io. CodeBuild runs on shared AWS IPs that Docker Hub rate-limits
# aggressively for anonymous pulls, and `agentcore deploy` builds this Dockerfile
# in CodeBuild — pulling from docker.io fails there with
# "429 Too Many Requests". ECR Public is not rate-limited from AWS infrastructure
# and mirrors the same official image and tags.
FROM public.ecr.aws/docker/library/python:3.13-slim-trixie

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# ── Optional corporate proxy CA (Netskope etc.) ───────────────────
# ca/ always exists (contains .keep); *.crt files in it are gitignored and
# only present on machines behind a TLS-intercepting proxy. In CodeBuild the
# directory is effectively empty and this step is a no-op.
COPY agents/dep-updater/ca/ /tmp/ca/
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && cp /tmp/ca/*.crt /usr/local/share/ca-certificates/ 2>/dev/null || true \
    && update-ca-certificates \
    && rm -rf /tmp/ca /var/lib/apt/lists/*

# ── System deps: git, curl, gh CLI ────────────────────────────────
ENV GH_VERSION=2.97.0
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git jq xz-utils libatomic1 \
    && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_arm64.deb" \
        -o /tmp/gh.deb \
    && dpkg -i /tmp/gh.deb && rm /tmp/gh.deb \
    && rm -rf /var/lib/apt/lists/*

# ── Node 26 via official binary tarball ────────────────────────────
ENV NODE_VERSION=26.6.0
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-arm64.tar.xz" \
        -o /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && node --version && npm --version

# ── pnpm (Node 26 no longer ships corepack) ───────────────────────
ENV PNPM_VERSION=11.21.0
RUN npm install -g "pnpm@${PNPM_VERSION}" && pnpm --version

# ── Python deps ───────────────────────────────────────────────────
# The repo layout is preserved inside the image so that the agent modules'
# `parent.parent.parent / packages / shared / generated` path resolution
# behaves identically in development and in the container.
WORKDIR /app/agents/dep-updater
COPY agents/dep-updater/pyproject.toml agents/dep-updater/uv.lock ./
RUN pip install --no-cache-dir uv && uv export --no-dev --format requirements-txt \
    > requirements.txt && pip install --no-cache-dir -r requirements.txt

# ── Generated shared contract ─────────────────────────────────────
# Imported by payload.py, emission.py and outcome_store.py via sys.path.
COPY packages/shared/generated/shared_contract.py /app/packages/shared/generated/

# ── Agent source ──────────────────────────────────────────────────
COPY agents/dep-updater/main.py \
     agents/dep-updater/logging_json.py \
     agents/dep-updater/payload.py \
     agents/dep-updater/emission.py \
     agents/dep-updater/outcome_store.py \
     ./

# Fail the build rather than the first invocation if an import is missing.
RUN python -c "import main, logging_json, payload, emission, outcome_store"

# AgentCore health-checks /ping and invokes /invocations on 8080.
EXPOSE 8080
CMD ["opentelemetry-instrument", "python", "main.py"]
