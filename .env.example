# Agent Fleet Control Panel — environment template.
#
# SD2 (spec §SD2): ALL Supabase access is server-side. RLS is deny-all with zero
# policies, so the service role key must never reach the browser. There is NO
# NEXT_PUBLIC_SUPABASE_* variable anywhere in this project — the service role key
# and Supabase URL are server-only, read exclusively in Server Components and
# route handlers.

# --- Supabase (server-only) ---
# The project REST/Realtime base URL. Server-only; do NOT prefix with NEXT_PUBLIC_.
SUPABASE_URL=

# Service role key. Bypasses RLS. Server-only; do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AWS (server-only, panel → AgentCore) ---
# Populated per spec §5 (Fly OIDC → AssumeRoleWithWebIdentity). Locally the AWS
# SDK resolves credentials from the ambient provider chain.
AWS_REGION=
AGENT_RUNTIME_ROLE_ARN=
