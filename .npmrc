# Enforce the engines.node bound (>=24 <27) instead of only warning, so an
# install on an unsupported Node fails with a clear message rather than silently
# producing a broken dependency tree. CI and the Docker image run Node 26;
# developers should `nvm use` (see .nvmrc). The range admits a fallback to Node
# 24 (#217 D-06) with no .npmrc change.
engine-strict=true
