# Enforce the engines.node bound (>=22 <25) instead of only warning, so an
# install on an unsupported Node (e.g. Node 26, which breaks the Next 15.5 CLI
# and leaves a partially-populated node_modules) fails with a clear message
# rather than silently producing a broken dependency tree. CI and the Docker
# image run Node 22; developers should `nvm use` (see .nvmrc).
engine-strict=true
