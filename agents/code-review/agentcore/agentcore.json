{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "codereview",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "codereview"
  },
  "runtimes": [
    {
      "name": "code_review",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/codeReview/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "executionRoleArn": "arn:aws:iam::755641879575:role/agent-fleet-code-review-runtime",
      "envVars": [
        { "name": "SUPABASE_URL", "value": "https://hegxeycmbmjfgzqpdiik.supabase.co" },
        { "name": "SUPABASE_KEY_SECRET_ID", "value": "agent-fleet/prod/SUPABASE_SERVICE_ROLE_KEY" },
        { "name": "MODEL_ID", "value": "deepseek.v3.2" },
        { "name": "PANEL_BASE_URL", "value": "https://dt-agent-fleet-panel.fly.dev" },
        { "name": "AWS_REGION", "value": "us-east-1" }
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 1800
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
