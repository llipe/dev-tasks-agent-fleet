# Secrets (local environment files are never committed)
.env.local

# CDK Build Artifacts
cdk/cdk.out/
cdk/node_modules/

# CLI Internals
#
# .cli/deployed-state.json is deliberately NOT committed: it records the AWS
# account ID, the runtime ARN and the AgentCore-generated execution role ARN,
# and this repository is public. That is the same reason
# agents/*/agentcore/aws-targets.json is ignored at the repo root. The CLI
# rebuilds this file from the deployed stack, so committing it buys nothing.
.cli/*

# Ephemeral Staging
.cache/*
