{
  "name": "depupdater",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "depupdater"
  },
  "runtimes": [
    {
      "name": "dep_updater",
      "description": "Autonomous dependency updater agent",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": ".",
      "buildContextPath": "../..",
      "dockerfile": "Dockerfile.dep-updater",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "GITHUB_SECRET_ID", "value": "dep-agent/github-app" },
        { "name": "GIT_COMMITTER_NAME", "value": "devtasks-agent-fleet[bot]" },
        { "name": "GIT_COMMITTER_EMAIL", "value": "4687256+devtasks-agent-fleet[bot]@users.noreply.github.com" },
        { "name": "AGENT_OBSERVABILITY_ENABLED", "value": "true" },
        { "name": "OTEL_PYTHON_DISTRO", "value": "aws_distro" },
        { "name": "OTEL_PYTHON_CONFIGURATOR", "value": "aws_configurator" },
        { "name": "OTEL_EXPORTER_OTLP_PROTOCOL", "value": "http/protobuf" },
        { "name": "OTEL_RESOURCE_ATTRIBUTES", "value": "service.name=dep-updater" }
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 300,
        "maxLifetime": 3600
      },
      "tags": {
        "agent:managed": "true",
        "agent:name": "dep-updater",
        "agent:domain": "security"
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
