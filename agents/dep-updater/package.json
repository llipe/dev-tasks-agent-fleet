{
  "name": "@fleet/dep-updater",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "uv run ruff check .",
    "lint:fix": "uv run ruff check . --fix",
    "format": "uv run ruff format .",
    "format:check": "uv run ruff format . --check",
    "typecheck": "uv run mypy --strict .",
    "test": "uv run pytest",
    "test:unit": "uv run pytest",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test"
  }
}
