{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {
              "id": "js/sql-injection",
              "name": "SqlInjection",
              "properties": {
                "security-severity": "9.3",
                "tags": ["security", "external/cwe/cwe-089"]
              },
              "defaultConfiguration": {"level": "error"}
            },
            {
              "id": "js/useless-assignment-to-local",
              "name": "UselessAssignment",
              "properties": {
                "tags": ["maintainability"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "js/sql-injection",
          "level": "error",
          "message": {"text": "This query string depends on a user-provided value."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "src/db/query.js"},
                "region": {"startLine": 42, "endLine": 44}
              }
            }
          ]
        },
        {
          "ruleId": "js/useless-assignment-to-local",
          "message": {"text": "This assignment to 'result' is useless."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "src/util/helpers.js"},
                "region": {"startLine": 10}
              }
            }
          ]
        }
      ]
    }
  ]
}
